{
  "name": "auralis-visualizer",
  "private": true,
  "version": "1.0.0",
  "description": "Offline music visualizer for mobile: reacts to microphone or local audio files.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host --port 4173",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "icons": "node scripts/make-icons.mjs",
    "e2e": "node scripts/e2e.mjs",
    "cap:sync": "npm run build && npx cap sync android",
    "android:assets": "node scripts/make-android-assets.mjs",
    "android:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
